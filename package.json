{
  "name": "airbnb-clone",
  "version": "1.0.0",
  "description": "A full-stack Airbnb-like application built with Node.js, Express.js, EJS templating, and Tailwind CSS",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "tailwindcss -i ./views/input.css -o ./public/output.css --minify",
    "tailwind:watch": "tailwindcss -i ./views/input.css -o ./public/output.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "airbnb",
    "express",
    "ejs",
    "tailwindcss",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
