<% if (home.isFavourite) { %>
  <form action="/favourites/delete/<%= home.id %>" method="POST">
    <button type="submit" class="bg-red-300 p-2 hover:bg-red-500">Remove from Favourite</button>
  </form>
<% } else { %>
  <form action="/favourites" method="POST">
    <button type="submit" class="bg-green-300 p-2 hover:bg-green-500">Add to Favourite</button>
    <input type="hidden" name="id" value="<%= home.id %>">
  </form>
<% } %>
