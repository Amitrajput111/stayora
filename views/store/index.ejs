<%- include('../partials/head') %>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="w-full max-w-7xl mx-auto px-4 py-8 flex-grow">
      <h2 class="text-2xl md:text-3xl text-red-500 font-bold text-center mb-6">
        Welcome to Stayora - Your Perfect Stay Awaits
      </h2>
      
      <!-- Search Bar -->
      <div class="mb-8">
        <form action="/" method="GET" class="max-w-2xl mx-auto">
          <div class="relative flex items-center">
            <input 
              type="text" 
              name="search" 
              placeholder="Search by location (e.g., Jaipur, Indore...)" 
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              class="w-full px-6 py-4 pr-14 text-gray-700 bg-white border-2 border-gray-300 rounded-full focus:outline-none focus:border-red-500 shadow-md"
            />
            <button 
              type="submit" 
              class="absolute right-2 bg-red-500 text-white p-2.5 rounded-full hover:bg-red-600 transition duration-300 flex items-center justify-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </div>
          <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <div class="text-center mt-3">
              <span class="text-gray-600">Showing results for: <strong>"<%= searchQuery %>"</strong></span>
              <a href="/" class="ml-3 text-red-500 hover:text-red-600 underline">Clear search</a>
            </div>
          <% } %>
        </form>
      </div>
      
      <!-- Featured Recommendations Section -->
      <% if (recommendations && recommendations.length > 0) { %>
        <div class="mb-10">
          <div class="flex items-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            <h3 class="text-xl font-semibold text-gray-800">Featured Stays for You</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            <% recommendations.forEach(home => { %>
              <div class="bg-gradient-to-br from-red-50 to-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300 border-2 border-red-200">
                <div class="relative">
                  <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover" onerror="this.src='/images/house1.png'">
                  <span class="absolute top-2 right-2 bg-red-500 text-white text-xs px-2 py-1 rounded-full">Popular Choice</span>
                </div>
                <div class="p-4">
                  <h3 class="text-lg font-semibold text-gray-800 mb-2 truncate"><%= home.houseName %></h3>
                  <p class="text-gray-600 mb-2 text-sm truncate">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <%= home.location %>
                  </p>
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-lg font-bold text-red-500">₹<%= home.price %> / night</span>
                    <div class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-1">
                        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                      </svg>
                      <span class="text-gray-700 text-sm"><%= home.rating %></span>
                    </div>
                  </div>
                  <a href="/homes/<%= home.id %>" class="block w-full bg-red-500 hover:bg-red-600 text-white text-center py-2 px-4 rounded transition duration-300">
                    View Details
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      
      <!-- All Properties Section -->
      <h3 class="text-xl font-semibold text-gray-800 mb-4">All Properties</h3>
      
      <% if (registeredHomes.length === 0) { %>
        <div class="text-center py-12">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <p class="text-gray-500 text-lg mb-2">No properties found</p>
          <p class="text-gray-400 text-sm mb-4">Try searching with a different location</p>
          <a href="/" class="inline-block bg-red-500 text-white py-2 px-6 rounded hover:bg-red-600 transition duration-300">
            View All Properties
          </a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover" onerror="this.src='/images/house1.png'">
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-800 mb-2 truncate"><%= home.houseName %></h3>
              <p class="text-gray-600 mb-2 text-sm truncate">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <%= home.location %>
              </p>
              <div class="flex justify-between items-center mb-3">
                <span class="text-lg font-bold text-red-500">₹<%= home.price %> / night</span>
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-1">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-700 text-sm"><%= home.rating %></span>
                </div>
              </div>
              <a href="/homes/<%= home.id %>" class="block w-full bg-green-500 hover:bg-green-600 text-white text-center py-2 px-4 rounded transition duration-300">
                View Details
              </a>
            </div>
          </div>
        <% }) %>
      </div>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
