<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="w-full max-w-5xl mx-auto px-4 py-8 flex-grow">
      <h2 class="text-2xl md:text-3xl font-bold text-red-500 mb-6 text-center">My Bookings</h2>
      <% if (bookings.length === 0) { %>
        <div class="text-center py-12">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-gray-500 text-lg mb-2">No bookings yet</p>
          <p class="text-gray-400 text-sm mb-4">Start exploring and book your perfect stay!</p>
          <a href="/homes" class="inline-block bg-red-500 text-white py-2 px-6 rounded hover:bg-red-600 transition duration-300">
            Browse Properties
          </a>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% bookings.forEach(booking => { %>
            <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition duration-300">
              <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div class="mb-3 md:mb-0">
                  <h3 class="text-lg font-semibold text-gray-800"><%= booking.userName %></h3>
                  <p class="text-sm text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <%= booking.email %>
                  </p>
                  <p class="text-sm text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <%= booking.phone %>
                  </p>
                </div>
                <div class="text-left md:text-right">
                  <p class="text-sm text-gray-600">Check-in: <span class="font-semibold"><%= booking.checkIn %></span></p>
                  <p class="text-sm text-gray-600">Check-out: <span class="font-semibold"><%= booking.checkOut %></span></p>
                  <span class="inline-block mt-2 bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full">Confirmed</span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
