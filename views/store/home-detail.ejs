<%- include('../partials/head') %>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-10 mb-8 flex-grow">
      <div class="bg-white shadow-lg rounded-lg overflow-hidden max-w-7xl mx-auto">
        <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-64 md:h-96 object-cover" onerror="this.src='/images/house1.png'">
        
        <div class="p-8 md:p-12">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
              <h1 class="text-4xl md:text-5xl font-extrabold text-gray-800 mb-3 tracking-tight"><%= home.houseName %></h1>
              <p class="text-gray-600 flex items-center text-xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <%= home.location %>
              </p>
            </div>
            <div class="mt-4 md:mt-0 text-left md:text-right">
              <div class="flex items-center md:justify-end mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 text-yellow-400 mr-2">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                </svg>
                <span class="text-3xl font-extrabold text-gray-800"><%= home.rating %></span>
              </div>
              <p class="text-4xl font-extrabold text-red-500">₹<%= home.price %> <span class="text-base text-gray-500 font-normal">/ night</span></p>
            </div>
          </div>

          <hr class="my-6">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-xl font-semibold text-gray-800 mb-4">Property Details</h3>
              <div class="space-y-3 text-gray-600">
                <p class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  <span>Entire property</span>
                </p>
                <p class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span>Enhanced cleaning</span>
                </p>
                <p class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                  <span>Self check-in</span>
                </p>
              </div>
              <div class="mt-6">
                <%- include('../partials/favourite', {home: home}) %>
              </div>
            </div>

            <div>
              <h3 class="text-xl font-semibold text-gray-800 mb-4">Book This Property</h3>
              <form action="/homes/<%= home.id %>/book" method="POST" class="space-y-4">
                <div>
                  <label class="block text-gray-700 text-sm font-semibold mb-2">Full Name</label>
                  <input 
                    type="text" 
                    name="userName" 
                    placeholder="Enter your name" 
                    required 
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
                  >
                </div>
                <div>
                  <label class="block text-gray-700 text-sm font-semibold mb-2">Email</label>
                  <input 
                    type="email" 
                    name="email" 
                    placeholder="your@email.com" 
                    required 
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
                  >
                </div>
                <div>
                  <label class="block text-gray-700 text-sm font-semibold mb-2">Phone</label>
                  <input 
                    type="tel" 
                    name="phone" 
                    placeholder="+91 1234567890" 
                    required 
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
                  >
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="block text-gray-700 text-sm font-semibold mb-2">Check-in</label>
                    <input 
                      type="date" 
                      name="checkIn" 
                      required 
                      class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
                    >
                  </div>
                  <div>
                    <label class="block text-gray-700 text-sm font-semibold mb-2">Check-out</label>
                    <input 
                      type="date" 
                      name="checkOut" 
                      required 
                      class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
                    >
                  </div>
                </div>
                <button 
                  type="submit" 
                  class="w-full bg-red-500 text-white py-3 rounded-md hover:bg-red-600 transition duration-300 font-semibold"
                >
                  Book Now
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Similar Properties Section -->
      <% if (similarProperties && similarProperties.length > 0) { %>
        <div class="mt-10">
          <div class="flex items-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <h3 class="text-2xl font-semibold text-gray-800">Similar Properties You Might Like</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% similarProperties.forEach(similar => { %>
              <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300">
                <img src="<%= similar.photoUrl %>" alt="<%= similar.houseName %>" class="w-full h-56 object-cover" onerror="this.src='/images/house1.png'">
                <div class="p-6">
                  <h4 class="text-xl font-bold text-gray-800 mb-2 truncate"><%= similar.houseName %></h4>
                  <p class="text-gray-600 mb-3 text-sm truncate">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <%= similar.location %>
                  </p>
                  <div class="flex justify-between items-center mb-4">
                    <span class="text-xl font-bold text-red-500">₹<%= similar.price %> / night</span>
                    <div class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-1">
                        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                      </svg>
                      <span class="text-gray-700 text-sm font-semibold"><%= similar.rating %></span>
                    </div>
                  </div>
                  <a href="/homes/<%= similar.id %>" class="block w-full bg-blue-500 hover:bg-blue-600 text-white text-center py-3 px-4 rounded transition duration-300 text-base font-semibold shadow-sm">
                    View Details
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
