<%- include('../partials/head') %>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="w-full max-w-4xl mx-auto px-4 py-8 flex-grow">
      <div class="bg-white rounded-lg shadow-md p-6 md:p-8">
        <h1 class="text-2xl md:text-3xl font-bold mb-6 text-center text-gray-800">
          <%= editing ? "Edit" : "Register"%> Your Property on Stayora
        </h1>
        <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" class="space-y-4">
          <% if (editing) { %>
            <input type="hidden" name="id" value="<%= home.id %>" />
          <% } %>
          
          <div>
            <label class="block text-gray-700 text-sm font-semibold mb-2">Property Name</label>
            <input
              type="text"
              name="houseName"
              value="<%= editing ? home.houseName : '' %>"
              placeholder="Enter your property name"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-gray-700 text-sm font-semibold mb-2">Price Per Night (₹)</label>
            <input
              type="number"
              name="price"
              value="<%= editing ? home.price : '' %>"
              placeholder="Enter price per night"
              required
              min="0"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-gray-700 text-sm font-semibold mb-2">Location</label>
            <input
              type="text"
              name="location"
              value="<%= editing ? home.location : '' %>"
              placeholder="Enter location"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-gray-700 text-sm font-semibold mb-2">Rating (1-5)</label>
            <input
              type="number"
              name="rating"
              value="<%= editing ? home.rating : '' %>"
              placeholder="Enter rating"
              required
              min="1"
              max="5"
              step="0.1"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-gray-700 text-sm font-semibold mb-2">Photo URL</label>
            <input
              type="url"
              name="photoUrl"
              value="<%= editing ? home.photoUrl : '' %>"
              placeholder="Enter photo URL"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-red-500 text-white py-3 rounded-md hover:bg-red-600 transition duration-300 font-semibold"
          >
            <%= editing ? "Update Property" : "Add Property" %>
          </button>
        </form>
      </div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
