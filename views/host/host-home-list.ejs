<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-4 md:p-8 mt-6 md:mt-10 max-w-7xl mb-8 flex-grow">
      <h2 class="text-xl md:text-3xl text-red-500 font-bold text-center mb-6">
        Manage Your Properties
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover" onerror="this.src='/images/house1.png'">
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-800 mb-2 truncate"><%= home.houseName %></h3>
              <p class="text-gray-600 mb-2 text-sm truncate">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <%= home.location %>
              </p>
              <div class="flex justify-between items-center mb-3">
                <span class="text-lg font-bold text-red-500">₹<%= home.price %> / night</span>
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-1">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-700 text-sm"><%= home.rating %></span>
                </div>
              </div>
              <div class="flex gap-2">
                <a href="/host/edit-home/<%= home.id %>?editing=true" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white text-center py-2 px-3 rounded transition duration-300 text-sm">
                  Edit
                </a>
                <form action="/host/delete-home/<%= home.id %>" method="POST" class="flex-1" onsubmit="return confirm('Are you sure you want to delete this property?');">
                  <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white py-2 px-3 rounded transition duration-300 text-sm">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
